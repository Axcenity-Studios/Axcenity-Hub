# Axcenity Hub: environment variables.
#
# Copy this file to .env (git-ignored) and fill in only what you need:
#     cp .env.example .env && chmod 600 .env
# Then let uv load it:
#     uv run --env-file .env python manage.py tailwind runserver
# (or `export UV_ENV_FILE=.env` once in your shell profile).
#
# Every setting has a development default, so an empty .env runs the site locally.
# Never commit .env or put a real secret in this file. Full reference:
# docs/ARCHITECTURE.md#settings.

# ---------- GitHub account linking (docs/architecture/github-linking.md) ----------
# An OAuth App (GitHub → Settings → Developer settings → OAuth Apps), with the callback
# http://127.0.0.1:8000/accounts/github/login/callback/ in development.
# Linking is off unless all three are set.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated Fernet keys for GitHub tokens at rest; the first encrypts, every one
# decrypts. Make one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep using the same key: tokens saved with a key can only be read with it.
GITHUB_TOKEN_KEYS=

# ---------- Cloudflare Turnstile on sign-up and password reset (optional) ----------
# Off unless both are set. Cloudflare's test keys work on localhost:
#   site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------- Email ----------
# Development prints emails to the runserver terminal (the console backend).
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# DJANGO_DEFAULT_FROM_EMAIL=Axcenity Hub <noreply@localhost>

# ---------- Engine docs sync (manage.py sync_engine_docs) ----------
# An absolute path (~ isn't expanded); the default is ~/Documents/VSCode Projects/Axcenity-Engine.
# AXCENITY_ENGINE_DIR="/home/you/Documents/VSCode Projects/Axcenity-Engine"

# ---------- Production only (DJANGO_DEBUG=false) ----------
# Production refuses to start without a real secret key and allowed hosts, and without
# GITHUB_TOKEN_KEYS when the GitHub app is set.
# DJANGO_DEBUG=false
# DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=hub.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://hub.example.com
# DJANGO_BEHIND_PROXY=false
# DJANGO_TRUSTED_PROXY_COUNT=1
# DJANGO_REDIS_URL=
# DJANGO_EMAIL_HOST=
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_EMAIL_USE_TLS=true
